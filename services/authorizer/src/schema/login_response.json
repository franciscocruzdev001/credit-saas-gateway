{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "id": "http://LoginResponse",
    "title": "LoginResponse",
    "type": "object",
    "additionalProperties": false,
    "definitions": {
        "creditorCompanyInfo": {
            "type": "object",
            "title": "creditorCompanyInfo",
            "additionalProperties": false,
            "properties": {
                "_id": {
                    "type": "string"
                },
                "companyName": {
                    "type": "string"
                },
                "socialReason": {
                    "type": "string"
                },
                "phoneNumber": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "chargeRules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/CreditorCompanyChargeRules"
                    }
                }
            },
            "required": [
                "_id",
                "companyName",
                "socialReason",
                "phoneNumber",
                "email"
            ]
        },
        "CreditorCompanyChargeRules": {
            "type": "object",
            "title": "CreditorCompanyChargeRules",
            "additionalProperties": false,
            "properties": {
                "chargeFrequency": {
                    "type": "string"
                },
                "chargePeriods": {
                    "type": "number"
                },
                "chargeDay": {
                    "type": "string"
                },
                "renovationPeriod": {
                    "type": "number"
                },
                "comissionRate": {
                    "type": "number"
                },
                "firstCharge": {
                    "type": "boolean"
                },
                "latePaymentCharge": {
                    "type": "number"
                }
            }
        },
        "WalletSnapshot": {
            "type": "object",
            "title": "WalletSnapshot",
            "additionalProperties": false,
            "description": "Foto del saldo de la wallet al momento del login: el front la usa para inicializar su cartera local y luego la reconcilia con /getWalletInfo (el servidor siempre tiene prioridad)",
            "properties": {
                "firmBalance": {
                    "type": "number"
                },
                "pendingIncomesBalance": {
                    "type": "number"
                },
                "pendingExpensesBalance": {
                    "type": "number"
                },
                "queriedAt": {
                    "type": "number",
                    "description": "Epoch millis (Date.now()) del momento exacto en que se consulto este saldo"
                }
            },
            "required": [
                "firmBalance",
                "pendingIncomesBalance",
                "pendingExpensesBalance",
                "queriedAt"
            ]
        }
    },
    "properties": {
        "token": {
            "type": "string"
        },
        "user": {
            "type": "object",
            "title": "user",
            "additionalProperties": false,
            "properties": {
                "_id": {
                    "type": "string"
                },
                "userName": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "roles": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "permissions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "creditorCompanyId": {
                    "type": "string"
                },
                "walletId": {
                    "type": "string"
                },
                "accountNumber": {
                    "type": "string"
                },
                "creditorCompanyInfo": {
                    "$ref": "#/definitions/creditorCompanyInfo"
                },
                "walletSnapshot": {
                    "$ref": "#/definitions/WalletSnapshot"
                }
            },
            "required": [
                "_id",
                "userName",
                "email",
                "roles",
                "permissions",
                "creditorCompanyId",
                "walletSnapshot"
            ]
        }
    },
    "required": [
        "token",
        "user"
    ]
}
