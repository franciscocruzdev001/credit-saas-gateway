{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "id": "http://SearchCreditsByEployeeRequest",
    "title": "SearchCreditsByEmployeeRequest",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "filtersItems": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "creditorCompanyId": {
                    "type": "string",
                    "description": "Ya no se usa para construir creditsFilters (creditorCompanyId sale del JWT); se deja opcional para no romper tipados existentes que la sigan enviando"
                },
                "userId": {
                    "type": "string"
                },
                "generalSearch": {
                    "type": "string"
                },
                "chargeFrequency": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "creditId": {
                    "type": "string"
                },
                "transactionId": {
                    "type": "string"
                }
            }
        },
        "pagination": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pageNumber": {
                    "type": "number"
                },
                "limit": {
                    "type": "number"
                }
            },
            "required": [
                "pageNumber",
                "limit"
            ]
        }
    },
    "required": [
        "filtersItems",
        "pagination"
    ]
}
